# Docker Compose
COMPOSE_PROJECT_NAME=my-fullstack-app
APP_PORT=80
FRONTEND_PORT=3000
BACKEND_PORT=8080
REDIS_PORT=6379

# PostgreSQL
POSTGRES_DB=my_fullstack_app
POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace-with-a-strong-unique-password
POSTGRES_PORT=5432

# Backend
SERVER_PORT=8080
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=604800
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# Frontend (production requests are routed by Nginx)
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_NAME=My Fullstack App
